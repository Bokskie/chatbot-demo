# ============================================================
#  bokskie.ai - API keys
#  I-COPY ANG FILE NA ITO:  cp .env.example .env
#  Tapos punan ng iyong totoong keys. Naka-.gitignore na ang .env.
#
#  Ang .env ay Option B. Kung gusto mo yung simplest setup,
#  gamitin ang keys.local.json (Option A) sa halip nito.
#  Dalawang paraan, hindi sabay - ang .env ang mas panalo dahil
#  pwede kang maglagay ng maraming key kahit walang UI.
#
#  Walang quotes kailangan, at walang kumma. Halimbawa:
#     OPENAI_API_KEY=sk-proj-abc123
# ============================================================

# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# https://aistudio.google.com/app/apikey  (may FREE tier)
GEMINI_API_KEY=

# Maraming key sa isang provider? Magdagdag ng pangalawang variable:
#   DEEPSEEK_API_KEY_2=sk-...
# Ang DEEPSEEK_KEY at GOOGLE_API_KEY ay tinatanggap din
# bilang alternatibong pangalan.
